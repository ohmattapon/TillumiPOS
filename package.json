{
  "name": "pos",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "workers/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web dev:media",
    "dev:api": "bun --env-file=.env --watch server/src/index.ts",
    "dev:web": "vite",
    "dev:media": "bun run --filter @pos/media dev",
    "dev:fake-kbank": "bun server/test/kbank-dev.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:media": "bun run --filter @pos/media deploy",
    "deploy:cloud": "bun run --filter @pos/cloud deploy",
    "db:up": "podman compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "cache:up": "podman compose -f docker-compose.yml -f docker-compose.dev.yml up -d redis",
    "db:generate": "bun --env-file=.env drizzle-kit generate",
    "db:migrate": "bun --env-file=.env server/src/infrastructure/database/migrate.ts",
    "db:seed": "bun --env-file=.env server/src/infrastructure/database/seed.ts",
    "db:seed:demo": "bun --env-file=.env server/src/infrastructure/database/seed-demo.ts",
    "db:seed:catalog": "bun --env-file=.env server/src/infrastructure/database/seed-demo-catalog.run.ts",
    "db:seed:packs": "bun --env-file=.env server/src/infrastructure/database/seed-packs.ts",
    "db:studio": "bun --env-file=.env drizzle-kit studio",
    "e2e": "bun run test:e2e-support && bun e2e/run.ts",
    "e2e:stock-receipts": "bun e2e/stock-receipts.ts",
    "screenshots": "bun e2e/shots.ts",
    "typecheck": "tsc -b && tsc -p server && bun run --filter '*' typecheck",
    "lint": "oxlint src e2e vite.config.ts",
    "test": "bun run test:api && bun run test:web && bun run test:e2e-support",
    "test:e2e-support": "bun test ./e2e/customer-display-requests.test.ts",
    "test:api": "cd server && bun --env-file=.env.test test",
    "test:unit": "cd server && bun --env-file=.env.test test src/domains src/libs src/modules",
    "test:web": "bun test ./src",
    "coverage": "bun run coverage:api && bun run coverage:web",
    "coverage:api": "cd server && bun --env-file=.env.test test --coverage",
    "coverage:web": "bun test ./src --coverage",
    "openapi:check": "cd server && bun --env-file=.env.test test/openapi-snapshot.ts check",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "exceljs": "4.4.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.56.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tsyringe": "^4.10.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.3",
    "lefthook": "^2.2.2",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
