{
  "name": "pos",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web dev:media",
    "dev:api": "bun run --filter @pos/api dev",
    "dev:web": "bun run --filter @pos/web dev",
    "dev:media": "bun run --filter @pos/media dev",
    "deploy:media": "bun run --filter @pos/media deploy",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "db:generate": "bun run --filter @pos/api db:generate",
    "db:migrate": "bun run --filter @pos/api db:migrate",
    "db:seed": "bun run --filter @pos/api db:seed",
    "e2e": "bun apps/web/e2e/run.ts",
    "screenshots": "bun apps/web/e2e/shots.ts",
    "scb:inquiry": "bun --env-file=.env apps/api/scripts/scb-inquiry.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter @pos/web lint",
    "test": "bun run --filter @pos/api test && bun run --filter @pos/web test",
    "test:unit": "bun run --filter @pos/api test:unit"
  }
}
