# The one environment file for the whole repo. Copy to .env and fill in.
# Each app reads only what it needs: see apps/*/package.json and apps/media/wrangler.jsonc.

# --- API (apps/api) ---
PORT=3000
CHECKOUT_MODE=legacy
DATABASE_URL=postgres://pos:pos@localhost:5433/pos
# Generate with: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=change-me
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Password for the "admin" account created by `bun run db:seed`.
SEED_OWNER_PASSWORD=admin1234

# --- Image storage (apps/media Worker) ---
# Local Worker: http://localhost:8787. Deployed Worker: its workers.dev or custom domain URL.
# Optional: leave MEDIA_URL and MEDIA_TOKEN empty to run without product images.
MEDIA_URL=http://localhost:8787
# Shared by the API and the Worker. In production also set it with `wrangler secret put MEDIA_TOKEN`.
MEDIA_TOKEN=change-me

# --- SCB QR payment (SCB Developer: Thai QR Code Tag 30) ---
# Leave these unset (or as the placeholders below) to keep taking PromptPay on trust, without a QR.
# Never put real values in this file: it is committed. Put them in your own .env.
SCB_API_KEY=your-scb-api-key
SCB_API_SECRET=your-scb-api-secret
# 15-digit biller id and Reference 3 prefix of your merchant profile.
SCB_BILLER_ID=your-15-digit-biller-id
SCB_REF3_PREFIX=ABC
# Sandbox by default. For production use the host SCB gave you with the production credentials,
# up to but not including /v1/..., e.g. https://api-partners.scb/partners
SCB_API_BASE_URL=https://api-sandbox.partners.scb/partners/sandbox
# true only if your merchant profile is set up for two references (reference 2 is then sent too).
SCB_TWO_REFERENCES=false
# Optional, needs a public HTTPS URL: register <your-domain>/api/v1/payments/qr/scb/confirmation
# as the payment confirmation URL in the SCB portal to confirm payments instantly. Without it the
# till checks with SCB every few seconds, which needs no public address.

# --- Install kit (docker-compose.yml) ---
# scripts/install.sh writes these for you. Set them by hand only if you start Compose yourself.
# Password of the database container (never published on a port).
POSTGRES_PASSWORD=your-database-password
# The web app is served by the API on PORT (above).
# DOMAIN=pos.example.com   (with `docker compose --profile https up -d`, and COOKIE_SECURE=true)
