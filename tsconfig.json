{
  "files": [],
  "compilerOptions": {
    // Bun applies the tsconfig of the working directory, and `bun run dev` and the seeds run the server from here:
    // tsyringe needs decorator metadata to build the use cases. (files is empty, so tsc -b does not compile with this.)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Read by Bun (tests, scripts) and editors; it must match tsconfig.app.json and vite.config.ts.
    "paths": {
      "@/*": ["./src/*"],
      "@pos/api": ["./server/src/app.ts"],
      "@pos/api/types": ["./server/src/types.ts"],
      "@pos/api/pricing": ["./server/src/domains/pricing.ts"],
      "@pos/api/packs": ["./server/src/domains/product-pack.ts"],
      "@pos/api/shop-settings": ["./server/src/domains/shop-settings.domain.ts"],
      "@pos/api/modifiers": ["./server/src/domains/modifier.domain.ts"],
      "@pos/api/promotions": ["./server/src/domains/promotion.domain.ts"],
      "@pos/api/dining-table": ["./server/src/domains/dining-table.domain.ts"],
      "@pos/api/permissions": ["./server/src/permissions.ts"]
    }
  },
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
