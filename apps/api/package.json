{
  "name": "@pos/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./types": "./src/types.ts",
    "./pricing": "./src/domains/pricing.ts",
    "./shop-settings": "./src/domains/shop-settings.domain.ts",
    "./modifiers": "./src/domains/modifier.domain.ts",
    "./promotions": "./src/domains/promotion.domain.ts",
    "./dining-table": "./src/domains/dining-table.domain.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=.env.test test",
    "test:unit": "bun --env-file=.env.test test src/domains src/libs src/modules",
    "openapi:check": "bun --env-file=.env.test test/openapi-snapshot.ts check",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/infrastructure/database/migrate.ts",
    "db:seed": "bun --env-file=../../.env src/infrastructure/database/seed.ts",
    "db:seed:demo": "bun --env-file=../../.env src/infrastructure/database/seed-demo.ts",
    "db:seed:catalog": "bun --env-file=../../.env src/infrastructure/database/seed-demo-catalog.run.ts",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@types/bun": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.2"
  }
}
