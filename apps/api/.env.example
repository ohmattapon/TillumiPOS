PORT=3000
DATABASE_URL=postgres://pos:pos@localhost:5433/pos
# สร้างค่าใหม่ด้วย: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=change-me
# อัตรา VAT หน่วย basis point (700 = 7%) ราคาสินค้าเป็นราคารวม VAT
VAT_RATE_BP=700
# ตั้งเป็น true เมื่อให้บริการผ่าน HTTPS
COOKIE_SECURE=false
SEED_OWNER_PASSWORD=admin1234

# Image storage Worker (apps/media). The token must match the Worker's MEDIA_TOKEN secret.
MEDIA_URL=http://localhost:8787
MEDIA_TOKEN=change-me
